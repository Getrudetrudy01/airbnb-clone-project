# Copy this file to .env and adjust values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite locally. Example for MySQL:
# DATABASE_URL=mysql://airbnb:airbnb@localhost:3306/airbnb

# Auth (optional overrides)
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
# AUTH_THROTTLE_RATE=10/min

# Payments (Stripe test mode). Leave empty to disable payments.
# Get keys at https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYMENTS_CURRENCY=usd
# FRONTEND_URL=http://localhost:3000

# Production / hardening (optional overrides)
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# BOOKING_PAYMENT_WINDOW_MINUTES=60
# ANON_THROTTLE_RATE=60/min
# USER_THROTTLE_RATE=300/min
# SECURE_HSTS_SECONDS=3600
# LOG_LEVEL=INFO

# Uploaded photos in production (see docs/deploy-railway.md)
# SERVE_MEDIA=True                 # serve MEDIA_ROOT from Django, e.g. on a Railway volume
# AWS_STORAGE_BUCKET_NAME=         # or use an S3-compatible bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=             # e.g. Cloudflare R2 endpoint

# First-start helpers (used by scripts/start.sh)
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=
# SEED_DEMO=False
